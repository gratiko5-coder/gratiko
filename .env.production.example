# ==============================================================
# GRATIKO — VARIABLES D'ENVIRONNEMENT DE PRODUCTION (VERCEL + SUPABASE)
# ==============================================================

# Mode d'exécution
NEXT_PUBLIC_APP_MODE="PRODUCTION"
APP_MODE="PRODUCTION"

# --------------------------------------------------------------
# 1. BASE DE DONNÉES SUPABASE (PostgreSQL Managé)
# --------------------------------------------------------------
# Obtenez ces URLs dans : Supabase Dashboard > Project Settings > Database > Connection String > URI
# Mode Transaction (PgBouncer/Supavisor - Port 6543) pour les Serverless Functions Vercel :
DATABASE_URL="postgresql://postgres.[VOTRE-PROJECT-REF]:[VOTRE-MOT-DE-PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mode Direct (Session - Port 5432) pour les migrations Prisma :
DIRECT_URL="postgresql://postgres.[VOTRE-PROJECT-REF]:[VOTRE-MOT-DE-PASSE]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --------------------------------------------------------------
# 2. SÉCURITÉ & JETONS DE SESSION
# --------------------------------------------------------------
# Générer avec : openssl rand -base64 64 (min 64 caractères)
JWT_SECRET="GENERER_UNE_CLE_ALEATOIRE_TRES_LONGUE_ET_SECURISEE"

# --------------------------------------------------------------
# 3. PARAMÈTRES RÉGIONAUX PAR DÉFAUT
# --------------------------------------------------------------
DEFAULT_COUNTRY_CODE="HT"
DEFAULT_CURRENCY="HTG"
DEFAULT_LOCALE="fr"

# --------------------------------------------------------------
# 4. INITIALISATION DU PREMIER SUPER-ADMINISTRATEUR (Lors du 1er seed)
# --------------------------------------------------------------
INITIAL_SUPERADMIN_EMAIL="direction@gratiko.com"
INITIAL_SUPERADMIN_PASSWORD="MotDePasseUniqueComplexe2026!"

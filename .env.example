# GRATIKO - Configuration Environnement (Exemple)
# IMPORTANT : Ne commettez jamais de secrets de production dans le dépôt.

# Mode d'exécution : "DEMO" (argent fictif) ou "PRODUCTION" (requiert validation réglementaire)
NEXT_PUBLIC_APP_MODE="DEMO"
APP_MODE="DEMO"

# Base de données (SQLite par défaut pour démo autonome, PostgreSQL recommandé en production)
DATABASE_URL="file:./dev.db"
# Exemple PostgreSQL Production :
# DATABASE_URL="postgresql://gratiko_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/gratiko_prod?schema=public"

# Secret JWT pour la signature des sessions serveur (min 32 caractères aléatoires)
JWT_SECRET="gratiko-demo-development-secret-key-change-in-production-2026"

# Paramètres initiaux de marché par défaut
DEFAULT_COUNTRY_CODE="HT"
DEFAULT_CURRENCY="HTG"
DEFAULT_LOCALE="fr"

# Création du premier Super-Administrateur via script d'initialisation (non utilisé en runtime)
INITIAL_SUPERADMIN_EMAIL="admin@gratiko.demo"
INITIAL_SUPERADMIN_PASSWORD="ChangeMe_Demo_Admin_2026!"
